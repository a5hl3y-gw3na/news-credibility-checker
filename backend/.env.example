# Copy to .env (never commit .env). Load with `uvicorn app.main:app --env-file .env`.
MODEL_PATH=models/model.joblib
# Comma-separated class names from the AI lead's dataset that mean "higher risk"
RISK_LABELS=1,fake,unreliable
# Optional: Google Fact Check Tools API key (evidence retrieval)
FACTCHECK_API_KEY=
